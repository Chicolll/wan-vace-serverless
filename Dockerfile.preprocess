# PREPROCESS endpoint image — SLIM, PINNED, GATED (2026-08-19).
# Replaces the devel-base build (runpod/pytorch devel = multi-GiB toolchain bloat,
# unpinned ComfyUI, superseded torch 2.4 layer). Pattern: the render side's
# trueslim rebuild — python-slim base, CUDA userspace entirely from pip cu128
# wheels, everything pinned, build-time node-class gate instead of hope.
#
# Models are NOT baked: host-NVMe model store (Chicolll/bg-replace-pipeline
# edit-preproc pin) resolved at container start by prep_setup.py, with a
# network-volume fallback. Same region + volume as the render endpoint is a
# HARD requirement (prep writes render's inputs).
FROM python:3.11-slim-bookworm

ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1 DEBIAN_FRONTEND=noninteractive \
    COMFY_DIR=/opt/ComfyUI
WORKDIR /opt

# opencv/SAM3 need libGL/glib; git only for the clone layer (purged after).
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# ComfyUI pinned to a release (v0.33.1, has TextEncodeQwenImageEditPlus) and the
# five node packs pinned to the 2026-08-19 HEAD SHAs the gate below validates.
# LoaderGGUF comes from calcuis/gguf (NOT city96 — different class names).
RUN git clone --depth 1 --branch v0.33.1 https://github.com/comfyanonymous/ComfyUI /opt/ComfyUI \
 && cd /opt/ComfyUI/custom_nodes \
 && git clone https://github.com/1038lab/ComfyUI-RMBG comfyui-rmbg \
      && (cd comfyui-rmbg && git checkout 9edb2bec3900) \
 && git clone https://github.com/Fannovel16/comfyui_controlnet_aux \
      && (cd comfyui_controlnet_aux && git checkout e8b689a513c3) \
 && git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite \
      && (cd ComfyUI-VideoHelperSuite && git checkout 4ee72c065db2) \
 && git clone https://github.com/kijai/ComfyUI-KJNodes \
      && (cd ComfyUI-KJNodes && git checkout 3f20054214fe) \
 && git clone https://github.com/calcuis/gguf \
      && (cd gguf && git checkout 452dfed232ca) \
 && find /opt/ComfyUI -name .git -type d -prune -exec rm -rf {} +

# Anna's mask node (MaskAreaFilter) — vendored, quality-load-bearing (06-30 halo lesson).
COPY aivfx_masktools /opt/ComfyUI/custom_nodes/aivfx_masktools

# Python deps: ComfyUI + node packs + worker runtime, then the torch cu128 trio
# LAST so no node requirement can downgrade it (2.8/0.23/2.8 = the proven combo;
# the cu128 wheels carry the whole CUDA userspace — no system toolkit).
# imageio-ffmpeg supplies the ffmpeg binary for VHS h264 output (proven on the
# render image; no apt ffmpeg).
RUN python -m pip install -r /opt/ComfyUI/requirements.txt \
        runpod requests websocket-client imageio-ffmpeg \
 && for d in /opt/ComfyUI/custom_nodes/*/; do \
      if [ -f "$d/requirements.txt" ]; then python -m pip install -r "$d/requirements.txt"; fi; \
    done \
 && python -m pip install --upgrade "torch==2.8.*" "torchvision==0.23.*" "torchaudio==2.8.*" \
      --index-url https://download.pytorch.org/whl/cu128 \
 && apt-get purge -y git && apt-get autoremove -y

# Runtime files.
COPY handler_preprocess.py             /opt/handler_preprocess.py
COPY prep_setup.py                     /opt/prep_setup.py
COPY prep_warmup_graph.json            /opt/prep_warmup_graph.json
COPY extra_model_paths_preprocess.yaml /opt/extra_model_paths.yaml
COPY gate_nodes.py                     /opt/gate_nodes.py
COPY pod_telemetry.sh                  /opt/pod_telemetry.sh

# BUILD-TIME GATE: boot ComfyUI on CPU, assert every node class the preprocess
# graph uses is registered, and bake the SQLite migrations + bytecode while at
# it. A missing class fails the BUILD, not a GPU canary.
RUN python /opt/gate_nodes.py \
 && python -m compileall -q -j0 /opt/ComfyUI || true

ENV EXTRA_MODEL_PATHS=/opt/extra_model_paths.yaml \
    PREP_BOOT_WARMUP=1
CMD ["python", "-u", "/opt/handler_preprocess.py"]
